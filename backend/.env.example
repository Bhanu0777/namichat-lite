PROJECT_NAME=NamiChat Lite
API_V1_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/namichat
DB_ECHO=false

# JWT — replace with a long random string in production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Redis (used for WebSocket pub/sub fan-out in multi-instance deployments)
REDIS_URL=redis://localhost:6379/0
